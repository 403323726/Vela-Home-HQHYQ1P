<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F13"
    android:orientation="vertical"
    android:paddingStart="54dp"
    android:paddingEnd="54dp"
    android:paddingTop="30dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/launcher_settings"
        android:textColor="#FFFFFFFF"
        android:textSize="32sp"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/settings_two_column_hint"
        android:textColor="#FF98A5AF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/settingsNav"
            android:layout_width="292dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/settings_panel_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_sections"
                android:textColor="#FF8E9AA4"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/navLayout"
                style="@style/SettingsNavItem"
                android:layout_marginTop="2dp"
                android:text="@string/settings_section_layout" />

            <TextView
                android:id="@+id/navAppearance"
                style="@style/SettingsNavItem"
                android:text="@string/settings_section_appearance" />

            <TextView
                android:id="@+id/navApps"
                style="@style/SettingsNavItem"
                android:text="@string/settings_section_apps" />

            <TextView
                android:id="@+id/navSystem"
                style="@style/SettingsNavItem"
                android:text="@string/settings_section_system" />

            <TextView
                android:id="@+id/navLanguage"
                style="@style/SettingsNavItem"
                android:text="@string/settings_section_language" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:padding="26dp"
            android:background="@drawable/settings_panel_bg">

            <ScrollView
                android:id="@+id/sectionLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="@string/settings_layout_title" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/settings_layout_hint" />

                    <TextView
                        android:id="@+id/reorderChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="20dp"
                        android:text="@string/reorder"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/columns_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="19sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                        <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                        <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                        <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/rows_below_dock_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="19sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                        <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                        <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                        <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/dock_opacity_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="19sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                        <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                        <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                        <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/sectionAppearance"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="@string/settings_appearance_title" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/settings_appearance_hint" />

                    <TextView
                        android:id="@+id/wallpaperChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="22dp" />

                    <TextView
                        android:id="@+id/animationsChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:id="@+id/advancedChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/advanced_effects_warning"
                        android:textColor="#FFACB8C1"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/followThemeChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="22dp"
                        android:text="@string/follow_theme" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/follow_theme_hint" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/sectionApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="@string/hidden_apps_title" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/hidden_apps_section_hint" />

                    <TextView
                        android:id="@+id/hiddenAppsChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="24dp" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/hidden_apps_manage_hint" />

                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/sectionSystem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="@string/settings_system_title" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/settings_system_hint" />

                    <TextView
                        android:id="@+id/dangbeiDesktopChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="22dp"
                        android:text="@string/dangbei_desktop_recovery_title" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/dangbei_desktop_settings_hint" />

                    <TextView
                        android:id="@+id/tvSettingsChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="18dp"
                        android:text="@string/tv_settings" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/sectionLanguage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="@string/settings_language_title" />

                    <TextView
                        style="@style/SettingsSectionHint"
                        android:text="@string/settings_language_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/languageChinese"
                            style="@style/SettingsColumnChoice"
                            android:text="@string/language_name_chinese" />

                        <TextView
                            android:id="@+id/languageEnglish"
                            style="@style/SettingsColumnChoice"
                            android:text="@string/language_name_english" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>